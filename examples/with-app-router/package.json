{
  "name": "with-app-router",
  "private": true,
  "scripts": {
    "build": "pnpm env:check && next build",
    "check": "pnpm run lint && pnpm run typecheck",
    "dev": "next dev --turbopack",
    "env:check": "astilba-env generate --config astilba.env.mts --check",
    "env:generate": "astilba-env generate --config astilba.env.mts",
    "format": "biome format --write src next.config.ts astilba.env.mts verify.mts",
    "lint": "biome check --fix src next.config.ts astilba.env.mts verify.mts",
    "start": "next start",
    "test": "pnpm build && tsx verify.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astilba/env": "0.2.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.9",
    "tsx": "^4.21.0",
    "typescript": "7.0.2"
  }
}
